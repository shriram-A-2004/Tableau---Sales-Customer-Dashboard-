          <datasource-dependencies datasource='Parameters'>
            <column caption='select year' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15w8pxc0wz6nvw103faom127oov1'>
            <column caption='{COUNTD([CY Orders])}' datatype='integer' name='[Calculation_0125346294231042]' role='measure' type='quantitative' user:unnamed='Total Orders'>
              <calculation class='tableau' formula='{COUNTD([Calculation_0274330099994624])}' />
            </column>
            <column caption='{[% Diff Orders]}' datatype='real' name='[Calculation_0125346294284291]' role='measure' type='quantitative' user:unnamed='Total Orders'>
              <calculation class='tableau' formula='{[Calculation_0274330100879362]}' />
            </column>
            <column caption='CY Orders' datatype='string' name='[Calculation_0274330099994624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1] THEN [Order ID]&#13;&#10;END' />
            </column>
            <column caption='PY Orders' datatype='string' name='[Calculation_0274330100293633]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1] - 1 THEN [Order ID]&#13;&#10;END' />
            </column>
            <column caption='% Diff Orders' datatype='real' name='[Calculation_0274330100879362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([Calculation_0274330099994624])-COUNTD([Calculation_0274330100293633]))/COUNTD([Calculation_0274330100293633])' />
            </column>
            <column caption='Max/Min Order' datatype='integer' name='[Calculation_0274330101301251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([Calculation_0274330099994624]) = WINDOW_MAX(COUNTD([Calculation_0274330099994624]))&#13;&#10;THEN COUNTD([Calculation_0274330099994624])&#13;&#10;ELSEIF COUNTD([Calculation_0274330099994624]) = WINDOW_MIN(COUNTD([Calculation_0274330099994624]))&#13;&#10;THEN COUNTD([Calculation_0274330099994624])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Sum' caption='Current Year' datatype='integer' default-format='n0;-0' name='[Calculation_1073674549665794]' role='dimension' type='ordinal'>
