            <run bold='true' fontcolor='#303030' fontname='Tableau Book' fontsize='22'><![CDATA[<[federated.15w8pxc0wz6nvw103faom127oov1].[sum:Calculation_0125346294231042:qk]>]]></run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#303030' fontname='Tableau Book' fontsize='12'><![CDATA[<[federated.15w8pxc0wz6nvw103faom127oov1].[sum:Calculation_0125346294284291:qk]>]]></run>
            <run fontcolor='#303030' fontname='Tableau Book' fontsize='12'>Æ </run>
            <run fontcolor='#898989' fontname='Tableau Book' fontsize='12'>vs. PY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders+' name='federated.15w8pxc0wz6nvw103faom127oov1' />
